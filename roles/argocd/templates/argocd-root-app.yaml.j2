# Managed by Ansible (roles/argocd) - the one root Application per PLAN.md
# Build Sequence step 6 (app-of-apps). Everything under
# argocd_git_repo_path in the GitOps repo should be further Application
# manifests, one per PLAN.md sync-wave component - this root app just
# applies whatever it finds there and lets each child's own sync-wave
# annotation order the rest. kube-vip and Cilium are NOT synced from here -
# PLAN.md "ARGO MUST NOT MANAGE".
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: root
  namespace: argocd
spec:
  project: platform
  source:
    repoURL: "{{ argocd_git_repo_url }}"
    targetRevision: "{{ argocd_git_repo_revision }}"
    path: "{{ argocd_git_repo_path }}"
    directory:
      recurse: true
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
