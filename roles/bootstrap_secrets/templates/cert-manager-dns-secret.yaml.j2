# Pre-Vault bootstrap secret (PLAN.md "Bootstrap Secrets") - AWS Route53
# credentials for cert-manager's DNS-01 solver against the public taco.moe
# zone (the private zone doesn't matter for ACME challenges). Needed before
# the cert-manager Argo wave can run. Ansible delivers it at genesis; once
# ESO exists, an ExternalSecret targeting this same name/namespace takes
# over silently.
#
# Both keys live here, not inlined in the ClusterIssuer - rke2-gitops is a
# public repo, and an AWS access key ID shouldn't be committed in the
# clear even though it's less sensitive than the secret key. The
# cert-manager wave's ClusterIssuer should reference both via
# accessKeyIDSecretRef/secretAccessKeySecretRef, not accessKeyID inline.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ cert_manager_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: cert-manager-dns-route53-credentials
  namespace: {{ cert_manager_namespace }}
type: Opaque
stringData:
  access-key-id: "{{ cert_manager_dns_aws_access_key_id }}"
  secret-access-key: "{{ cert_manager_dns_aws_secret_access_key }}"
