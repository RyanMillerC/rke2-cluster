# Pre-Vault bootstrap secret (PLAN.md "Bootstrap Secrets") - AWS credentials
# for Vault's AWS KMS auto-unseal. Ansible-forever: Vault can't unseal
# itself with a secret only it can serve, so this never hands off to ESO.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ vault_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: vault-aws-kms-creds
  namespace: {{ vault_namespace }}
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: "{{ vault_aws_kms_access_key_id }}"
  AWS_SECRET_ACCESS_KEY: "{{ vault_aws_kms_secret_access_key }}"
