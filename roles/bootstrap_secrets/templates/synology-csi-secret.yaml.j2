# Pre-Vault bootstrap secret - the DSM login the Synology CSI driver needs
# before the storage Argo wave can run. Ansible delivers it at genesis on
# every rebuild; once ESO exists, an ExternalSecret targeting this same
# name/namespace takes over silently.
#
# Namespace, Secret name, and the client-info.yml key match the upstream
# driver's default manifests (SynologyOpenSource/synology-csi).
{% set client_info = {'clients': [{
     'host': synology_csi_host,
     'port': synology_csi_port,
     'https': true,
     'username': synology_csi_username,
     'password': synology_csi_password}]} %}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ synology_csi_namespace }}
  labels:
    pod-security.kubernetes.io/enforce: privileged
---
apiVersion: v1
kind: Secret
metadata:
  name: client-info-secret
  namespace: {{ synology_csi_namespace }}
type: Opaque
stringData:
  client-info.yml: |
    {{ client_info | to_nice_yaml(indent=2) | indent(4) }}
