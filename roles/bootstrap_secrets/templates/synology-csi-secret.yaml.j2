# Pre-Vault bootstrap secret (PLAN.md "Bootstrap Secrets") - Synology DSM
# credential the CSI driver needs before the storage Argo wave can run.
# Ansible delivers it at genesis on every rebuild; once ESO exists, an
# ExternalSecret targeting this same name/namespace takes over silently.
#
# NAMESPACE AND KEY SCHEMA ARE PROVISIONAL - finalize against the real
# driver manifests when the storage wave is built in rke2-gitops
# (platform/synology-csi/), per PLAN.md's open item.
apiVersion: v1
kind: Namespace
metadata:
  name: {{ synology_csi_namespace }}
---
apiVersion: v1
kind: Secret
metadata:
  name: synology-csi-credentials
  namespace: {{ synology_csi_namespace }}
type: Opaque
stringData:
  username: "{{ synology_csi_username }}"
  password: "{{ synology_csi_password }}"
